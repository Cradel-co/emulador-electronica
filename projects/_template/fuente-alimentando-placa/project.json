{
  "schemaVersion": 1,
  "name": "fuente-alimentando-placa",
  "board": "esp32-s3-devkitc-1",
  "language": "micropython",
  "modules": [
    {
      "id": "board",
      "type": "esp32-s3-devkitc-1",
      "x": 133,
      "y": 22,
      "props": {
        "usb": false
      }
    },
    {
      "id": "led1",
      "type": "led",
      "x": -500,
      "y": 212,
      "props": {
        "color": "red"
      }
    },
    {
      "id": "sw1",
      "type": "switch",
      "x": -255,
      "y": 108,
      "props": {
        "label": "Interruptor"
      }
    },
    {
      "id": "fuenteregu1",
      "type": "fuente-regulable",
      "x": 174,
      "y": 609,
      "props": {
        "voltage": 5
      }
    },
    {
      "id": "r1",
      "type": "resistor",
      "x": -284,
      "y": 443,
      "props": {
        "ohms": 220
      }
    }
  ],
  "wires": [
    {
      "from": "led1.IN",
      "to": "board.GPIO7"
    },
    {
      "from": "sw1.OUT",
      "to": "board.GPIO6"
    },
    {
      "from": "sw1.GND",
      "to": "board.GND"
    },
    {
      "from": "fuenteregu1.GND",
      "to": "board.GND_4"
    },
    {
      "from": "fuenteregu1.V",
      "to": "board.5V"
    },
    {
      "from": "led1.GND",
      "to": "r1.1"
    },
    {
      "from": "r1.2",
      "to": "board.GND"
    }
  ],
  "sim": {
    "wifiSsid": "sim-wifi",
    "wifiPassword": "sim-password"
  }
}
