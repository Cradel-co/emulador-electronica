{
  "schemaVersion": 1,
  "name": "prueba",
  "board": "esp32-s3-devkitc-1",
  "language": "micropython",
  "modules": [
    {
      "id": "board",
      "type": "esp32-s3-devkitc-1",
      "x": 133,
      "y": 22,
      "props": {}
    },
    {
      "id": "led1",
      "type": "led",
      "x": -500,
      "y": 212,
      "props": {
        "color": "red"
      }
    },
    {
      "id": "btn1",
      "type": "button",
      "x": -125,
      "y": 40,
      "props": {
        "label": "Botón"
      }
    },
    {
      "id": "r1",
      "type": "resistor",
      "x": -281,
      "y": 398,
      "props": {
        "ohms": 110
      }
    }
  ],
  "wires": [
    {
      "from": "btn1.GND",
      "to": "board.GND"
    },
    {
      "from": "btn1.OUT",
      "to": "board.GPIO6"
    },
    {
      "from": "led1.IN",
      "to": "board.GPIO7"
    },
    {
      "from": "led1.GND",
      "to": "r1.1"
    },
    {
      "from": "r1.2",
      "to": "board.GND"
    }
  ],
  "sim": {
    "wifiSsid": "sim-wifi",
    "wifiPassword": "sim-password"
  }
}
