{
  "controls": [
    {
      "kind": "momentary",
      "label": "Apretar"
    }
  ],
  "props": {
    "label": {
      "type": "string",
      "default": "Botón",
      "label": "Nombre"
    }
  },
  "type": "button",
  "name": "Pulsador",
  "category": "Entradas",
  "description": "Botón momentáneo. Mientras lo apretás pone el pin a GND (pull-up: activo en 0).",
  "width": 70,
  "height": 64,
  "pins": [
    {
      "name": "OUT",
      "x": 22,
      "y": 64,
      "kind": "digital-out"
    },
    {
      "name": "GND",
      "x": 48,
      "y": 64,
      "kind": "ground"
    }
  ],
  "switch": true,
  "bridge": {
    "role": "input",
    "pin": "OUT",
    "activeLevel": 0,
    "pull": "up"
  },
  "svg": "module.svg",
  "model": "model.ts",
  "parte": {"fabricante": "Omron", "mpn": "B3F-1000", "descripcion": "Pulsador táctil 6 × 6 mm, de agujero pasante"},
  "esquematico": {
    "referencia": "SW",
    "valor": "{{props.label}}",
    "simbolo": "Switch:SW_Push",
    "huella": "Button_Switch_THT:SW_PUSH_6mm",
    "pines": {"OUT": "1", "GND": "2"},
    "fabricacion": "discreto",
    "notas": ["Las cuatro patas van de a pares: 1-2 es un lado, 3-4 el otro (la huella ya lo une)."]
  }
}
