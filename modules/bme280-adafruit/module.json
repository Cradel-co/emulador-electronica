      "y": 76,
      "kind": "power"
    },
    {
      "name": "GND",
      "x": 40,
      "y": 76,
      "kind": "ground"
    },
    {
      "name": "SCK",
      "x": 55,
      "y": 76,
      "kind": "digital-in"
    },
    {
      "name": "SDO",
      "x": 70,
      "y": 76,
      "kind": "digital-io"
    },
    {
      "name": "SDI",
      "x": 85,
      "y": 76,
      "kind": "digital-io"
    },
    {
      "name": "CS",
      "x": 100,
      "y": 76,
      "kind": "digital-in"
    }
  ],
  "controls": [],
  "props": {
    "sdo": {
      "type": "string",
      "default": "alto",
      "enum": [
        "alto",
        "bajo"
      ],
      "label": "SDO sin cablear (pull-up de la placa)"
    }
  },
  "svg": "module.svg",
  "model": "model.js",
  "drivers": {
    "arduino": {
      "librerias": [
        "Adafruit BME280 Library@2.3.0",
