        "Adafruit BusIO@1.17.4"
      ]
    }
  },
  "chips": [
    {
      "id": "bosch-bme280",
      "pines": {
        "SCK": "SCK",
        "SDI": "SDI",
        "SDO": "SDO",
        "CS": "CSB",
        "3VO": "VDD",
        "GND": "GND"
      },
      "porCableado": {
        "sdo": {
          "pin": "SDO",
          "aTierra": "bajo",
          "aAlimentacion": "alto"
